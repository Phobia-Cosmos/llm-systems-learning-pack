{
  "model_type": "minigpt",
  "architectures": [
    "MiniGPTForCausalLM"
  ],
  "vocab_size": 11,
  "block_size": 8,
  "max_position_embeddings": 8,
  "n_layer": 1,
  "num_hidden_layers": 1,
  "n_head": 2,
  "num_attention_heads": 2,
  "n_embd": 8,
  "hidden_size": 8,
  "dropout": 0.0,
  "bias": true,
  "fused_qkv": true,
  "position_encoding": "rope",
  "rope_theta": 10000.0,
  "sinusoidal_theta": 10000.0,
  "norm_type": "layernorm",
  "norm_eps": 1e-05,
  "mlp_type": "dense",
  "activation": "gelu",
  "hidden_act": "gelu",
  "intermediate_size": 32,
  "tie_word_embeddings": true,
  "torch_dtype": "float16"
}
